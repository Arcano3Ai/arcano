# ==============================================================================
# ARCANO — VARIABLES DE ENTORNO (PRODUCCIÓN & DESARROLLO)
# ==============================================================================

# Supabase Auth & PostgreSQL (Costo $0 USD/mes - Free Tier)
# Obtén estas llaves en https://supabase.com -> Tu Proyecto -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key

# Opcional: Mercado Pago Checkout Pro (Para pagos automatizados con tarjeta/OXXO)
# Obtén estas llaves en https://www.mercadopago.com.mx/developers
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-tu-public-key
MERCADOPAGO_ACCESS_TOKEN=TEST-tu-access-token

# Base Path (solo si se aloja en subdirectorio como /arcano en GitHub Pages)
# NEXT_PUBLIC_BASE_PATH=
