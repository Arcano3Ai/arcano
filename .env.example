# 1. Supabase Auth, PostgreSQL & Storage (Free Tier o Pro)
# Obtén estas llaves en https://supabase.com -> Tu Proyecto -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://myxwjlgyxmuqwnevloav.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key

# 2. Mercado Pago Checkout Pro (México - Tarjetas, SPEI, OXXO, MSI)
# Obtén estas llaves en https://www.mercadopago.com.mx/developers
# En desarrollo: TEST-xxx | En producción: APP_USR-xxx
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-e613045d-7524-4f81-9b16-419b48625902
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu-access-token-produccion

# 3. Stripe (Tarjetas Internacionales, Google Pay, Apple Pay)
# Obtén estas llaves en https://dashboard.stripe.com/apikeys
# En desarrollo: pk_test_xxx / sk_test_xxx | En producción: pk_live_xxx / sk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_tu_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_tu_stripe_secret_key

# 4. PayPal REST API v2
# Obtén estas llaves en https://developer.paypal.com/dashboard/applications
# Sandbox: sb | Producción: Client ID de tu App Business
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sb

# 5. Verificación de Motores de Búsqueda (SEO)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=tu-google-site-verification-id
